# HTTP port of the API server
PORT=8000
# Allowed web origins (comma-separated), e.g. https://example.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Finished-game timelines (replay); a volume or DB-backed path on the deployment server
TIMELINE_CACHE_DIR=timelines
# statsapi = follow live games; off = replay only (no model loading)
FEED_SOURCE=off
# AVG (default) | B3 | B2E | B2
MODEL=AVG
# Team followed live (MLB team id, e.g. 147 = Yankees); empty = first game of the day
TEAM_ID=
# Season of the models for live serving (default: current year)
SEASON=
# LED cells
N_LEDS=40
# Optional
SENTRY_DSN=
MQTT_URL=
